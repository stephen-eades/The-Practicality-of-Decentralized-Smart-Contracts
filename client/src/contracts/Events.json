  "source": "// SPDX-License-Identifier: MIT\npragma solidity >=0.4.22 <0.7.0;\n\ncontract Events {\n\n    // model a poll event\n    struct PollEvent {\n        uint id;\n        string pollName;\n        bool active;\n        uint totalVotesCast;\n        uint numberOfParties;\n    }\n\n    // model a escrow event\n    struct EscrowEvent {\n        uint id;\n        string wagerName;\n        bool active;\n        uint wagerPot;\n        uint numberOfParties;\n    }\n\n    // model a wager event\n    struct WagerEvent {\n        uint id;\n        string wagerName;\n        bool active;\n        uint wagerPot;\n        uint numberOfParties;\n    }\n\n}",
